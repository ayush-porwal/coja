{
  "name": "@ayushporwal/coja",
  "version": "0.0.1",
  "description": "Local code review for GitHub pull requests, with an AI sidepanel that helps the human reviewer",
  "type": "module",
  "bin": {
    "coja": "./bin/coja.js"
  },
  "files": [
    "bin",
    "dist",
    "public"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts --no-open",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node bin/coja.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/openai": "4.0.58",
    "@hono/node-server": "2.1.1",
    "@napi-rs/keyring": "2.0.0",
    "ai": "7.0.92",
    "hono": "4.13.7",
    "zod": "4.5.4"
  }
}
